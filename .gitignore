# ---- Personal data: NEVER commit -------------------------------------------------
# Everything Garmin downloads (health data, cycle data, weigh-ins, workout IDs)
data/
# Garmin login tokens (normally saved in ~/.garminconnect, outside the repo - this is a safety net)
.garminconnect/
.garth/
garmin_tokens.json
oauth*_token.json
*token*.json
# Secrets of any kind
.env
.env.*
.streamlit/secrets.toml
*.pem
*.key
# Your private training plan (copy girlgarmin/plans/example_plan.py to my_plan.py and edit it)
girlgarmin/plans/my_plan.py
# Personal scripts and notes that aren't part of the project
personal/
*.xlsx
~$*.xlsx
# Original activity files
*.fit
*.FIT

# ---- Python --------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# ---- Editors / OS --------------------------------------------------------------
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
